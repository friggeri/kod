{
  "sourceLanguage": "en",
  "strings": {
    "%@ is no longer available.\nIt may have been deleted or moved outside Kod.": {
      "comment": "Editor placeholder explaining that an open file was deleted or moved",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is no longer available.\nIt may have been deleted or moved outside Kod."
          }
        }
      }
    },
    "Active editor group": {
      "comment": "Accessibility value indicating this is the currently active editor group",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active editor group"
          }
        }
      }
    },
    "Close %@": {
      "comment": "Accessibility label for a tab chip's close button, naming the specific file it closes",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close %@"
