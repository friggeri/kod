  "strings": {
    "%@, %lld match%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld match%3$@"
          }
        }
      },
      "comment": "Accessibility label for a search-result file row, naming the file and its match count",
      "extractionState": "manual"
    },
    "%lld matches in %lld files.": {
