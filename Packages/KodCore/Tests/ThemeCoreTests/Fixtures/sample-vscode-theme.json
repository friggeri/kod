{
  "$schema": "vscode://schemas/color-theme",
  "name": "Sample Imported Theme",
  "type": "dark",
  "colors": {
    "editor.background": "#101418",
    "editor.foreground": "#E6E6E6",
    "editorLineNumber.foreground": "#5C6773",
    "sideBar.background": "#0B0E11",
    "editor.someTotallyMadeUpKey": "#123456",
    "statusBar.background": "#123456",
    "statusBar.foreground": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#11AA11",
    "gitDecoration.modifiedResourceForeground": "#2266AA",
    "gitDecoration.deletedResourceForeground": "#CC2233",
    "gitDecoration.renamedResourceForeground": "#33AA77",
    "gitDecoration.untrackedResourceForeground": "#44BB55",
    "gitDecoration.ignoredResourceForeground": "#778899",
    "gitDecoration.stageModifiedResourceForeground": "#DDAA55",
    "gitDecoration.stageDeletedResourceForeground": "#EE6677",
    "gitDecoration.conflictingResourceForeground": "#FF33AA"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "foreground": "#5C7E10",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword control",
      "scope": ["keyword.control", "keyword.control.conditional"],
      "settings": {
        "foreground": "#FF6AC1",
        "fontStyle": "bold",
        "someUnsupportedTokenSetting": true
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "foreground": "#C3E88D"
      }
    }
  ],
  "semanticTokenColors": {
    "variable.readonly": "#82AAFF",
    "class": {
      "foreground": "#FFCB6B",
      "bold": true,
      "someUnsupportedSemanticSetting": 42
    }
  },
  "someTopLevelKeyKodDoesNotUnderstand": true
}
